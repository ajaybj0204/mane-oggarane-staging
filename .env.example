# All six values below must be configured before connected end-to-end testing.
NEXT_PUBLIC_SUPABASE_URL=https://YOURPROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_PRIVATE_SERVICE_ROLE_KEY
RAZORPAY_KEY_ID=rzp_test_REPLACE
RAZORPAY_KEY_SECRET=YOUR_PRIVATE_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_SEPARATE_WEBHOOK_SECRET
# Optional canonical app URL for redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required for scheduled expiration of abandoned carts
CRON_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
RATE_LIMIT_SALT=REPLACE_WITH_PRIVATE_RANDOM_SALT

# STAGING DEFAULT: leave these undefined for existing Test Mode staging.
# ISOLATED PUBLIC PRELAUNCH PROJECT ONLY: set BOTH explicitly to prelaunch.
# MNO_SITE_PHASE=prelaunch
# NEXT_PUBLIC_SITE_PHASE=prelaunch
# This repository does not yet enable live payment keys in ANY phase.
# Run npm run qa:prelaunch with separately stored production environment variables before attaching your domain.

# Public sales demo deployment only: shows a "test payments only" banner.
# NEXT_PUBLIC_DEMO_MODE=true
